# ======================================================
# Android / Gradle 特定忽略规则 (针对导出的 Android 文件夹)
# ======================================================

# Android Studio / Gradle 构建产物
/Android/.gradle/
/Android/.idea/
/Android/build/
/Android/app/build/
/Android/[Ll]ibrary/
/Android/[Tt]emp/
/Android/[Oo]bj/
/Android/captures/
/Android/local.properties
/Android/.externalNativeBuild/
/Android/.cxx/

# 签名文件 (极其重要：千万不要把签名文件传到公开仓库)
/Android/*.keystore
/Android/*.jks
/Android/*.p12
/Android/keystore.properties

# 导出的 APK/AAB 文件
*.apk
*.aab
*.ap_
*.dex

